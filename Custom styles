/* Sibigi-AI Custom Styles */
​:root {
--bg-primary: #0f172a;
--bg-secondary: #1e293b;
--accent-color: #2563eb;
--text-primary: #f8fafc;
--text-secondary: #94a3b8;
}
​body {
background-color: var(--bg-primary);
color: var(--text-primary);
font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
margin: 0;
padding: 0;
}
​.chat-container {
max-width: 800px;
margin: 0 auto;
height: calc(100vh - 160px);
overflow-y: auto;
padding: 20px;
}
​.message {
margin-bottom: 15px;
display: flex;
align-items: flex-start;
gap: 10px;
}
​.message.user {
flex-direction: row-reverse;
}
​.message-content {
padding: 12px 16px;
border-radius: 12px;
max-width: 70%;
line-height: 1.5;
}
​.message.ai .message-content {
background-color: var(--bg-secondary);
color: var(--text-primary);
border-top-left-radius: 2px;
}
​.message.user .message-content {
background-color: var(--accent-color);
color: #ffffff;
border-top-right-radius: 2px;
}
​.avatar {
width: 36px;
height: 36px;
border-radius: 50%;
background-color: var(--accent-color);
display: flex;
align-items: center;
justify-content: center;
font-weight: bold;
}
